{
  "timeouts": {
    "tool_call_gap_secs": 180
  },
  "mcp_servers": {
    "nrepl": {
      "command": "bunx",
      "args": ["nrepl-mcp-server"],
      "env": {},
      "enabled": true
    },
    "playwright": {
      "command": "bunx",
      "args": ["@playwright/mcp@latest", "--headless", "--isolated", "--no-sandbox"],
      "env": {},
      "enabled": true
    }
  }
}
