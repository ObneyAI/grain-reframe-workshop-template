{
  "timeouts": {
    "tool_call_gap_secs": 180
  },
  "mcp_servers": {
    "nrepl": {
      "command": "npx",
      "args": ["-y", "nrepl-mcp-server"],
      "env": {},
      "enabled": true
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless", "--isolated", "--no-sandbox"],
      "env": {},
      "enabled": true
    }
  }
}
