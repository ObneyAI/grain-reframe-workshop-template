# Local defaults are shown for discoverability. Copy this file to `.env`,
# customize it, then export it before starting the backend.
APP_ENV=development
APP_NAME="Grain Re-frame Workshop Template"
APP_HTTP_PORT=8080
APP_BASE_URL=https://reframe-template.localhost
APP_DEV_HOSTNAME=reframe-template
APP_JWT_SECRET=dev-secret-change-me
APP_TENANT_ID=b1d4d3e2-0000-4000-8000-000000000001
APP_EMAIL_FROM=noreply@grain-reframe-workshop-template.local
APP_AUTH_COOKIE_NAME=grain-reframe-workshop-template-session
APP_COOKIE_SECURE=false
APP_LOCALE=en-US
APP_TIME_ZONE=UTC
APP_SKIP_EVENT_MODEL_GUARD=false
APP_STORAGE_DIR=storage
