{:aliases
 {:dev {:extra-paths ["development/src"]
        :extra-deps {org.clojure/clojure {:mvn/version "1.12.0"}

                     ;; Foundation components
                     poly/config {:local/root "components/config"}
                     poly/jwt  {:local/root "components/jwt"}
                     poly/auth {:local/root "components/auth"}
                     poly/email {:local/root "components/email"}
                     poly/email-smtp {:local/root "components/email-smtp"}
                     poly/email-ses {:local/root "components/email-ses"}
                     poly/file-store {:local/root "components/file-store"}
                     poly/file-store-s3 {:local/root "components/file-store-s3"}
                     poly/url-presigner {:local/root "components/url-presigner"}
                     poly/url-presigner-aws {:local/root "components/url-presigner-aws"}
                     poly/crypto {:local/root "components/crypto"}
                     poly/crypto-kms {:local/root "components/crypto-kms"}
                     poly/webhooks {:local/root "components/webhooks"}
                     poly/observability {:local/root "components/observability"}

                     ;; Service components
                     poly/user-service {:local/root "components/user-service"}

                     ;; Base
                     poly/web-api {:local/root "bases/web-api"}}
        :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                   "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"]}

  :test {:extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}

  :poly {:main-opts ["-m" "polylith.clj.core.poly-cli.core"]
         :extra-deps {polylith/clj-poly {:mvn/version "0.2.22"}}
         :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"]}}}
