{
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n cljs,css 'npx shadow-cljs watch app' 'npm run css:dev'",
    "css:dev": "npx @tailwindcss/cli -i ./src/css/main.css -o ../../bases/web-api/resources/public/css/main.css --watch",
    "build": "npm run css:build && npx shadow-cljs release app",
    "css:build": "npx @tailwindcss/cli -i ./src/css/main.css -o ../../bases/web-api/resources/public/css/main.css --minify",
    "test": "npx shadow-cljs compile test && node out/test/node-tests.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "concurrently": "^9.2.0",
    "shadow-cljs": "3.2.0",
    "tailwindcss": "^4.1.12"
  },
  "dependencies": {
    "@grain/shadcn": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
