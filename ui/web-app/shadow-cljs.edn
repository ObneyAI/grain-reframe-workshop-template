{:deps {:aliases [:dev :test]}
 :js-options {:js-package-dirs ["../../node_modules"]}
 :builds
 {:app
  {:target :browser
   :output-dir "../../bases/web-api/resources/public/js"
   :asset-path "/js"
   :modules {:main {:init-fn app.core/init}}
   :compiler-options {:output-feature-set :es2020}
   :devtools {:after-load app.core/render}}

  :test
  {:target :node-test
   :output-to "out/test/node-tests.js"
   :ns-regexp "-test$"
   :autorun false}}}
