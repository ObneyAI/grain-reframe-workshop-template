{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nrepl": {
      "type": "local",
      "command": ["npx", "nrepl-mcp-server"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp", "--headless", "--isolated", "--no-sandbox"],
      "enabled": true
    }
  },
  "agent": {
    "grain-builder": { "mode": "primary" },
    "grain-architect": { "mode": "primary" },
    "grain-planner": { "mode": "primary" },
    "grain-designer": { "mode": "primary" },
    "grain-verifier": {
      "mode": "primary",
      "tools": { "write": false, "edit": false, "bash": false, "patch": false }
    },
    "grain-inspector": {
      "mode": "primary",
      "tools": { "write": false, "edit": false, "bash": false, "patch": false }
    }
  }
}
